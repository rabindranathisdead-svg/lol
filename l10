E10.1
c
#include <stdio.h>

int main(void)
{
    double x, total = 0;
    int count = 0;

    printf("Enter values, negative to stop: ");
    scanf("%lf", &x);
    while (x >= 0) {
        total = total + x;
        count = count + 1;
        scanf("%lf", &x);
    }

    if (count > 0) {
        printf("Count   %d\n", count);
        printf("Total   %.2f\n", total);
        printf("Average %.2f\n", total / count);
    } else
        printf("No values were entered.\n");
    return 0;
}

Input 5 3 -1 gives Count 2, Total 8.00, Average 4.00. Input -1 prints “No values were entered.”

